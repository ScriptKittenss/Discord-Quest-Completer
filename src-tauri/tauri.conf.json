{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Script Kittens Quest Complete",
  "version": "1.0.0",
  "identifier": "com.scriptkittens.questcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Script Kittens Quest Complete",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Script Kittens",
    "copyright": "Copyright © 2026 Script Kittens. All rights reserved.",
    "shortDescription": "Script Kittens Discord Quest Complete",
    "longDescription": "Official Script Kittens Discord Quest Complete by 1shot-1moan.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  }
}