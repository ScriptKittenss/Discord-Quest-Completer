# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Vue
node_modules
dist
dist-ssr
build
*.local

# Rust / Cargo Build Artifacts (This catches the 900+ files!)
**/target/
**/*.rs.bk

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

_target
# Exclude binaries and executables these are built by the build process/Generated Custom Runners & Resources
src-tauri/resources/*.exe
src-tauri/resources/src-darwin
src-tauri/resources/src-win.exe
src-tauri/resources/src-linux
src-tauri/resources/src-macos

# Generated app icons (built from public/logo.svg via `pnpm icons`)
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-win/icon.ico

# Regenerated by cargo at build time (too large for API push)
src-tauri/Cargo.lock

# 11MB bundled game list — fetched at build time (see scripts/ensure-gamelist.mjs)
public/gamelist.json
src/assets/gamelist.json
